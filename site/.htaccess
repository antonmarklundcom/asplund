# Asplund Eltjänst — Apache (Hostinger). router.php mirrors these rules locally.

Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /route.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + no www
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /path/index.php → /path/
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.php[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]

  # Internal code and data are never served.
  RewriteRule ^(lib|content|templates|tools|docs|logs|dist)(/|$) route.php [L]
  RewriteRule ^(config|config\.example|router)\.php$ route.php [L]
  # Repo files that ride along with a Git deploy: README, verify.sh, .git, .gitignore.
  RewriteRule ^(README\.md|verify\.sh)$ route.php [L]
  RewriteRule (^|/)\.(?!well-known/) route.php [L]

  # Everything that is not a real file or directory: redirects, slash fix, 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ route.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|woff2|svg|webp|avif|jpg|jpeg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
